AUSTIN_AI_BRAIN_ROOT=E:\AUSTIN_AI_BRAIN
PROOF_TRANSFORMER_EMBED_DIM=384
PROOF_TRANSFORMER_EMBED_BACKEND=hash
PROOF_TRANSFORMER_EMBED_MODEL=hash-embedding-v1
# For a stronger local embedding backend, install sentence-transformers and set:
# PROOF_TRANSFORMER_EMBED_BACKEND=sentence-transformers
# PROOF_TRANSFORMER_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
PROOF_TRANSFORMER_CHUNK_TOKENS=180
PROOF_TRANSFORMER_CONTEXT_TOKENS=1200
PROOF_TRANSFORMER_TOP_K=6
PROOF_TRANSFORMER_GRAPH_HOPS=2
PROOF_TRANSFORMER_RANKER_LR=0.12
PROOF_TRANSFORMER_WATCH_POLL=2.0
PROOF_TRANSFORMER_COMMAND_TIMEOUT=120
# Optional local model backends
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
# LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
# LLAMA_CPP_N_PREDICT=384
